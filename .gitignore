.env
*.db
data/
# except the demo's own kit plasmid (MIT, see demo/data/LICENSE.moclo-registry)
!demo/data/

# Local backup destination used for testing
backups/

__pycache__/

# Left by install.sh
pre-install-backup/
.install-state*
.env.before-install-*
.env.rolled-back-*

# The https certificates (scripts/make-certs.sh): keys, never committed
certs/
certs-ca/
# ...nor copies of them, nor a key, certificate or request kept anywhere else
certs*.bak*/
certs.bak*/
*.key
*.pem
*.p12
*.pfx
*.csr
# Copies of .env carry its secrets too
.env.bak*
.env.*.bak

# Previews the icon scripts write next to themselves
docs/icon/*.html
docs/icon/trellis.svg
